{
  "expo": {
    "name": "Mercurio Capital",
    "slug": "mercurio-capital",
    "version": "0.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mercurio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mercuriocapital.app",
      "associatedDomains": ["applinks:mercuriocapitalsa.com.br"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "A Mercúrio Capital usa o Face ID para desbloquear sua sessão neste aparelho."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.mercuriocapital.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mercuriocapitalsa.com.br",
              "pathPrefix": "/c/proposta/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "O Mercurio Capital precisa da câmera para capturar seus documentos."
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0F0F0F"
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "A Mercúrio Capital usa o Face ID para desbloquear sua sessão neste aparelho."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9cc0b449-b952-417f-a1a0-0b2f6855027c"
      }
    }
  }
}
