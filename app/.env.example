# Mercurio Capital — app web (Vite). Copie para .env.local e preencha.
# TUDO aqui é público por definição (vai no bundle). NUNCA colocar segredos.

# Supabase (obrigatório)
VITE_SUPABASE_URL=https://bhagksfvszeogtjvjtpx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Push web — Frente A (opcional; sem estas chaves toda a UI de push se oculta)
# Console Firebase → projeto → app web. Config pública + chave VAPID pública.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# URLs e observabilidade (opcionais)
VITE_PUBLIC_APP_URL=https://mercuriocapitalsa.com.br
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_RECAPTCHA_SITEKEY=
VITE_SESSION_EXPIRED_MESSAGE=

# Desktop (Electron) — release feed
VITE_DESKTOP_RELEASE_OWNER=
VITE_DESKTOP_RELEASE_REPO=
