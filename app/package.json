{
  "name": "mercurio-capital-app",
  "private": true,
  "version": "0.0.4",
  "description": "Desktop foundation for Mercurio Capital web app",
  "homepage": "https://www.mercuriocapitalsa.com.br",
  "author": {
    "name": "Mercurio Capital",
    "email": "engineering@mercuriocapitalsa.com.br"
  },
  "type": "module",
  "main": "desktop/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop:web": "tsc -b && vite build --mode desktop",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:dev:web": "vite --host 127.0.0.1 --port 5173",
    "desktop:dev:app": "wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .",
    "desktop:dev": "concurrently -k -n WEB,DESKTOP \"npm:desktop:dev:web\" \"npm:desktop:dev:app\"",
    "desktop:pack:mac": "electron-builder --config electron-builder.json --mac --x64 --arm64 --publish never",
    "desktop:pack:win": "electron-builder --config electron-builder.json --win --x64 --publish never",
    "desktop:pack:linux": "electron-builder --config electron-builder.json --linux AppImage deb --x64 --publish never",
    "desktop:build": "npm run build:desktop:web && npm run desktop:pack:mac && npm run desktop:pack:win && npm run desktop:pack:linux",
    "maintenance:resend-pending-partner-invites": "node scripts/maintenance/resend-pending-partner-invites.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@sentry/react": "^8.40.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.59.20",
    "@types/qrcode": "^1.5.6",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.456.0",
    "posthog-js": "^1.181.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-google-recaptcha": "^3.1.0",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.59.20",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-google-recaptcha": "^2.1.9",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.3"
  }
}
